# Delete Artist and Related Data
def delete_artist():
    artist_id = input("Enter Artist ID to delete: ")
    conn = connect_db()
    cursor = conn.cursor()
    cursor.execute("DELETE FROM exhibition WHERE artist_id = %s", (artist_id,))
    cursor.execute("DELETE FROM sales WHERE artist_id = %s", (artist_id,))
    cursor.execute("DELETE FROM artist WHERE artist_id = %s", (artist_id,))
    conn.commit()
    print("Artist and related data deleted successfully.")
    conn.close()
# Display all tables in condensed format
def display_tables_condensed():
    conn = connect_db()
    cursor = conn.cursor(dictionary=True)
    print("\n============================== ARTISTS ==============================")
    cursor.execute("SELECT * FROM artist")
    artists = cursor.fetchall()
    for artist in artists:
        print(f"{artist['artist_id']}. {artist['name']} - {artist['artwork']} | {artist['medium']}, {artist['size']} | {artist['contact_info']}")
    print("\n============================== EXHIBITION ==============================")
    cursor.execute("SELECT * FROM exhibition")
    exhibitions = cursor.fetchall()
    for exhibition in exhibitions:
        print(f"{exhibition['exhibition_id']}. {exhibition['title']} | Artist: {exhibition['artist_id']} | {exhibition['location']} | {exhibition['start_date']} to {exhibition['end_date']}")
    print("\n============================== SALES ==============================")
    cursor.execute("SELECT * FROM sales")
    sales = cursor.fetchall()
    for sale in sales:
        print(f"{sale['artist_id']}. {sale['client']} | Artist: {sale['artist_id']} | {sale['sale_date']} | ${sale['price']}")
    conn.close()

