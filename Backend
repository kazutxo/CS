CREATE DATABASE art_gallery;
USE art_gallery;
CREATE TABLE artist (artist_id INT PRIMARY KEY AUTO_INCREMENT, name VARCHAR(100) NOT NULL,artwork VARCHAR(100) NOT NULL,medium VARCHAR(50) NOT NULL,size VARCHAR(50) NOT NULL,contact_info VARCHAR(255) NOT NULL);
CREATE TABLE exhibition ( exhibition_id INT PRIMARY KEY AUTO_INCREMENT, artist_id INT NOT NULL,title VARCHAR(100) NOT NULL,location VARCHAR(100) NOT NULL, start_date DATE NOT NULL,end_date DATE NOT NULL,FOREIGN KEY (artist_id) REFERENCES artist(artist_id) ON DELETE CASCADE);
CREATE TABLE sales (sale_id INT PRIMARY KEY AUTO_INCREMENT, artist_id INT NOT NULL,client_name VARCHAR(100) NOT NULL,sale_date DATE NOT NULL,price DECIMAL(10, 2) NOT NULL,FOREIGN KEY (artist_id) REFERENCES artist(artist_id) ON DELETE CASCADE);
